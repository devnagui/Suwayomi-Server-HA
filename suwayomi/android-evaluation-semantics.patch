+package xyz.nulldev.androidcompat.webkit
+
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+import kotlinx.serialization.json.putJsonObject
+import org.graalvm.polyglot.Context
+import kotlin.test.Test
+import kotlin.test.assertEquals
+
+/**
+ * Real JS completion plus production response conversion, not native CDP/provider execution.
+ * Uses the existing polyglot dependency, as the replaced JsHandlerTest did.
+ */
+class HAAllMangaEvaluationTest {
+    @Test
+    fun exactAllMangaPredicateKeepsTrueAndFalseThroughProductionConversion() {
+        for ((titleMatch, overlayMatch, expected) in
+            listOf(
+                Triple(false, false, "false"),
+                Triple(true, false, "true"),
+                Triple(false, true, "true"),
+            )
+        ) {
+            Context.create("js").use { context ->
+                context.eval(
+                    "js",
+                    """
+                    var document = {
+                      title: ${if (titleMatch) "'Just a moment'" else "'ordinary page'"},
+                      querySelector: function () { return ${if (overlayMatch) "{}" else "null"}; }
+                    };
+                    """.trimIndent(),
+                )
+                val completion =
+                    context.eval(
+                        "js",
+                        """
+                        document.title.includes("Just a moment") ||
+                        document.querySelector('.captcha-overlay--visible') != null
+                        """.trimIndent(),
+                    )
+                val response = buildJsonObject { putJsonObject("result") { put("value", completion.asBoolean()) } }
+                assertEquals(expected, androidEvaluationResult(response.toString()))
+            }
+        }
+    }
+}
