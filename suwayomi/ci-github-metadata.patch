+package suwayomi.tachidesk.server.util
+
+import eu.kanade.tachiyomi.network.GET
+import okhttp3.Request
+
+internal fun githubMetadataRequest(
+    url: String,
+    token: String? = System.getenv("HA_CI_GITHUB_TOKEN"),
+): Request {
+    val request = GET(url)
+    if (token == null) return request
+    require(token.isNotEmpty() && token.all { it.code in 33..126 }) {
+        "Invalid CI GitHub metadata token"
+    }
+    if (request.url.scheme != "https" || request.url.host != "api.github.com" || request.url.port != 443) {
+        return request
+    }
+    return request.newBuilder()
+        .header("Authorization", "Bearer $token")
+        .header("Cache-Control", "no-store")
+        .build()
+}
