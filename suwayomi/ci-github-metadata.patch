+package suwayomi.tachidesk.server.util
+
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFailsWith
+import kotlin.test.assertNull
+
+class HAGithubMetadataRequestTest {
+    @Test
+    fun metadataAuthenticationIsOptInAndLimitedToTheCanonicalHttpsApi() {
+        val url = "https://api.github.com/repos/example/example/releases/latest"
+        assertNull(githubMetadataRequest(url, null).header("Authorization"))
+        assertEquals("Bearer fixture-only", githubMetadataRequest(url, "fixture-only").header("Authorization"))
+        assertEquals("no-store", githubMetadataRequest(url, "fixture-only").header("Cache-Control"))
+        for (external in
+            listOf(
+                "http://api.github.com/repos/example/example",
+                "https://api.github.com:8443/repos/example/example",
+                "https://api.github.com.example.org/repos/example/example",
+                "https://raw.githubusercontent.com/example/example/master/mapping.json",
+                "https://release-assets.githubusercontent.com/fixture",
+            )
+        ) {
+            assertNull(githubMetadataRequest(external, "fixture-only").header("Authorization"))
+        }
+    }
+
+    @Test
+    fun malformedTokensFailWithoutIncludingTheirValueInTheError() {
+        for (invalid in listOf("", "private fixture", "private\nfixture", "private\u007ffixture")) {
+            val error =
+                assertFailsWith<IllegalArgumentException> {
+                    githubMetadataRequest("https://api.github.com/repos/example/example", invalid)
+                }
+            assertEquals("Invalid CI GitHub metadata token", error.message)
+        }
+    }
+}
