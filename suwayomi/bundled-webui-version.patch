+package suwayomi.tachidesk.graphql
+
+import kotlinx.coroutines.runBlocking
+import suwayomi.tachidesk.graphql.types.WebUIChannel
+import suwayomi.tachidesk.graphql.types.WebUIFlavor
+import suwayomi.tachidesk.server.generated.BuildConfig
+import suwayomi.tachidesk.server.serverConfig
+import suwayomi.tachidesk.server.util.WebInterfaceManager
+import suwayomi.tachidesk.test.ApplicationTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+
+class HABundledWebUIVersionTest : ApplicationTest() {
+    @Test
+    fun `custom bundled check reports packaged revision without hiding a mismatch`() =
+        runBlocking {
+            val originalChannel = serverConfig.webUIChannel.value
+            val originalFlavor = serverConfig.webUIFlavor.value
+            try {
+                serverConfig.webUIChannel.value = WebUIChannel.BUNDLED
+                serverConfig.webUIFlavor.value = WebUIFlavor.CUSTOM
+                assertEquals(
+                    BuildConfig.HA_WEBUI_TAG to false,
+                    WebInterfaceManager.isUpdateAvailable(WebUIFlavor.CUSTOM, BuildConfig.HA_WEBUI_TAG, raiseError = true),
+                )
+                assertEquals(
+                    BuildConfig.HA_WEBUI_TAG to true,
+                    WebInterfaceManager.isUpdateAvailable(WebUIFlavor.CUSTOM, "r0", raiseError = true),
+                )
+            } finally {
+                serverConfig.webUIChannel.value = originalChannel
+                serverConfig.webUIFlavor.value = originalFlavor
+            }
+        }
+}
